# Copy to .env (`cp .env.example .env`). Every variable of the project is listed here.
# Values below are DEMO values for local development only; change them for any real deployment.

# ---- Postgres (docker compose service `postgres`) ----
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=restaurant_dev_password
POSTGRES_DB=restaurant
# Host port published on 127.0.0.1 for local tools/tests.
POSTGRES_HOST_PORT=5432

# ---- Database access ----
# Used by the db-init job and the API inside compose (host `postgres`).
DATABASE_URL=postgres://restaurant:restaurant_dev_password@postgres:5432/restaurant
# Used by tests that run on the host. Needs a role allowed to CREATE DATABASE; each test file
# creates and drops its own throwaway database.
TEST_DATABASE_URL=postgres://restaurant:restaurant_dev_password@127.0.0.1:5432/restaurant

# ---- Restaurant ----
# Business-day boundary for check numbers and reports.
RESTAURANT_TZ=Europe/Kyiv

# ---- Seed (demo users; logins are listed in README) ----
SEED_WAITER_PASSWORD=waiter-demo-pass
SEED_COOK_PASSWORD=cook-demo-pass
SEED_MANAGER_PASSWORD=manager-demo-pass
# true = wipe everything and reseed on startup
SEED_RESET=false

# ---- API (apps/api; parsed and defaulted in apps/api/src/env.ts) ----
# Only DATABASE_URL (above) is required. Everything below is optional: defaults are shown.
API_PORT=4000
# Port on which the whole app is reachable on your machine (nginx).
HTTP_PORT=8080
# Hours a login stays valid.
SESSION_TTL_HOURS=12
# Set true when the site is served over HTTPS (cookie gets the Secure flag and __Host- prefix).
COOKIE_SECURE=false
# Browser origins allowed to call state-changing endpoints (CSRF defence), comma separated.
WEB_ORIGINS=http://localhost:8080,http://localhost:3000
# Reverse proxies whose X-Forwarded-For is believed (IPs/CIDRs, comma separated). Empty = none.
# 172.30.0.10 is the fixed address of the nginx container in docker-compose.yml.
TRUSTED_PROXIES=172.30.0.10
BODY_LIMIT_KB=64
LOG_LEVEL=log

# Rate limiting: in-process token buckets per client IP (no Redis).
RATE_LIMIT_ENABLED=true
# A whole restaurant can share one NAT address, so the general limits are generous.
RATE_LIMIT_GLOBAL_BURST=300
RATE_LIMIT_GLOBAL_PER_SEC=100
# Per address (a whole shift can sign in from one NAT address)…
RATE_LIMIT_LOGIN_IP_BURST=30
RATE_LIMIT_LOGIN_IP_PER_MIN=30
# …but only 5 tries per address AND account: brute force on one account is stopped quickly.
RATE_LIMIT_LOGIN_USER_BURST=5
RATE_LIMIT_LOGIN_USER_PER_MIN=5
# Password hashing is CPU heavy: at most this many logins are processed at once.
LOGIN_MAX_CONCURRENCY=4
SSE_MAX_PER_IP=10
SSE_MAX_PER_USER=5
